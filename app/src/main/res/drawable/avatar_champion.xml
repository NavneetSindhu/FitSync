<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    
    <!-- Background Circle with Gold/Amber Linear Gradient -->
    <path android:pathData="M50,0A50,50 0 1,0 50,100A50,50 0 1,0 50,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#78350F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gold-Trimmed Varsity Champion Jacket -->
    <path
        android:pathData="M20,96 C22,78 32,72 50,72 C68,72 78,78 80,96 L80,100 L20,100 Z"
        android:fillColor="#92400E" />

    <!-- Gold Collar Trim -->
    <path
        android:pathData="M38,72 L50,86 L62,72 Z"
        android:fillColor="#FDE68A" />
    <path
        android:pathData="M44,72 L50,80 L56,72 Z"
        android:fillColor="#1E293B" />

    <!-- Neck -->
    <path
        android:pathData="M44,58 L56,58 L56,72 L44,72 Z"
        android:fillColor="#FBBF24" />

    <!-- Head / Face -->
    <path
        android:pathData="M35,40 C35,26 65,26 65,40 C65,56 57,64 50,64 C43,64 35,56 35,40 Z"
        android:fillColor="#FEF3C7" />

    <!-- Eyes -->
    <path android:pathData="M42,46 A2,2 0 1,0 42,50 A2,2 0 1,0 42,46 Z" android:fillColor="#1E293B" />
    <path android:pathData="M58,46 A2,2 0 1,0 58,50 A2,2 0 1,0 58,46 Z" android:fillColor="#1E293B" />

    <!-- Victorious Smile -->
    <path android:pathData="M45,55 C48,59 52,59 55,55" android:strokeColor="#78350F" android:strokeWidth="2" android:strokeLineCap="round" />

    <!-- Hair -->
    <path
        android:pathData="M32,36 C34,22 66,22 68,36 C64,30 58,28 50,28 C42,28 36,30 32,36 Z"
        android:fillColor="#1E293B" />

    <!-- Gold Champion Crown / Headpiece -->
    <path
        android:pathData="M34,24 L42,32 L50,18 L58,32 L66,24 L64,34 L36,34 Z"
        android:fillColor="#FDE047" />
    <!-- Crown Gem -->
    <path android:pathData="M49,26 A1.5,1.5 0 1,0 51,26 A1.5,1.5 0 1,0 49,26 Z" android:fillColor="#EF4444" />
