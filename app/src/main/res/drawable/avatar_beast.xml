<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    
    <!-- Background Circle with Deep Purple Gradient -->
    <path android:pathData="M50,0A50,50 0 1,0 50,100A50,50 0 1,0 50,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C3AED" />
                <item android:offset="1.0" android:color="#1E1B4B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Heavy Lifter Sleeveless Hoodie -->
    <path
        android:pathData="M16,96 C18,74 28,68 50,68 C72,68 82,74 84,96 L84,100 L16,100 Z"
        android:fillColor="#4C1D95" />

    <!-- Hoodie V-Neck Trim -->
    <path
        android:pathData="M38,68 L50,84 L62,68 Z"
        android:fillColor="#A78BFA" />

    <!-- Heavy Traps / Neck -->
    <path
        android:pathData="M42,54 L58,54 L58,70 L42,70 Z"
        android:fillColor="#D97706" />

    <!-- Head / Strong Jaw -->
    <path
        android:pathData="M34,36 C34,22 66,22 66,36 C66,54 58,62 50,62 C42,62 34,54 34,36 Z"
        android:fillColor="#FDE68A" />

    <!-- Determined Eyebrows & Eyes -->
    <path android:pathData="M39,41 L47,43" android:strokeColor="#1E1B4B" android:strokeWidth="2.5" android:strokeLineCap="round" />
    <path android:pathData="M53,43 L61,41" android:strokeColor="#1E1B4B" android:strokeWidth="2.5" android:strokeLineCap="round" />
    <path android:pathData="M42,46 A2,2 0 1,0 42,50 A2,2 0 1,0 42,46 Z" android:fillColor="#1E1B4B" />
    <path android:pathData="M58,46 A2,2 0 1,0 58,50 A2,2 0 1,0 58,46 Z" android:fillColor="#1E1B4B" />

    <!-- Determined Grit Smile / Jawline -->
    <path android:pathData="M45,55 C48,57 52,57 55,55" android:strokeColor="#78350F" android:strokeWidth="2" android:strokeLineCap="round" />

    <!-- Backward Snapback Cap -->
    <path
        android:pathData="M32,34 C32,18 68,18 68,34 Z"
        android:fillColor="#1E1B4B" />
    <!-- Backward Cap Brim -->
    <path
        android:pathData="M28,34 C38,30 62,30 72,34 L70,38 C60,34 40,34 30,38 Z"
        android:fillColor="#8B5CF6" />
    <!-- Snapback Strap -->
    <path android:pathData="M44,28 L56,28" android:strokeColor="#F59E0B" android:strokeWidth="2" />
</vector>
