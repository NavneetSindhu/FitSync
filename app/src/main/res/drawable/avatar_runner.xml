<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    
    <!-- Background Circle with Emerald Gradient -->
    <path android:pathData="M50,0A50,50 0 1,0 50,100A50,50 0 1,0 50,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#064E3B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speed Running Windbreaker Body -->
    <path
        android:pathData="M20,96 C22,78 32,72 50,72 C68,72 78,78 80,96 L80,100 L20,100 Z"
        android:fillColor="#047857" />

    <!-- Neon Zip & Collar Detail -->
    <path
        android:pathData="M43,72 L50,86 L57,72 Z"
        android:fillColor="#6EE7B7" />
    <path
        android:pathData="M49,72 L49,94"
        android:strokeColor="#FCD34D"
        android:strokeWidth="2" />

    <!-- Neck -->
    <path
        android:pathData="M44,58 L56,58 L56,72 L44,72 Z"
        android:fillColor="#FBBF24" />

    <!-- Head / Face -->
    <path
        android:pathData="M35,40 C35,26 65,26 65,40 C65,56 57,64 50,64 C43,64 35,56 35,40 Z"
        android:fillColor="#FDE68A" />

    <!-- Aerodynamic Sports Sunglasses / Visor -->
    <path
        android:pathData="M32,40 C40,36 60,36 68,40 L66,48 C58,44 42,44 34,48 Z"
        android:fillColor="#0F172A" />
    <path
        android:pathData="M36,42 C44,39 56,39 64,42"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.5" />

    <!-- Energetic Runner Smile -->
    <path android:pathData="M46,55 C48,59 52,59 54,55" android:strokeColor="#064E3B" android:strokeWidth="2" android:strokeLineCap="round" />

    <!-- Running Visor / Cap -->
    <path
        android:pathData="M28,34 C36,28 64,28 72,34 L68,30 C60,22 40,22 32,30 Z"
        android:fillColor="#065F46" />
</vector>
